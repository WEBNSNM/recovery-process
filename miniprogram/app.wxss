page{background:#f6f8fb;color:#17212b;font-family:sans-serif}.container{padding:24rpx 24rpx 140rpx}.title{font-size:44rpx;font-weight:bold;margin:14rpx 0 25rpx}.notice{padding:20rpx;background:#fff8e7;border-radius:18rpx;font-size:25rpx;margin-bottom:20rpx}.card{background:white;padding:26rpx;margin:18rpx 0;border-radius:22rpx}.heading{font-size:32rpx;font-weight:bold;margin:30rpx 0 16rpx}.value{font-size:52rpx;color:#2878e8}.muted{color:#74808d;font-size:24rpx;margin-top:10rpx}.field{margin-bottom:24rpx}.field-name{font-size:26rpx;color:#596675;margin-bottom:10rpx}input,textarea,.picker{background:#f6f8fb;border:1rpx solid #dce3ea;padding:18rpx;border-radius:12rpx;width:auto}textarea{height:140rpx}button{font-size:26rpx;margin:10rpx 0}.primary{background:#2878e8;color:white}.danger{color:#c83737}.actions{display:flex;gap:12rpx}.actions button{flex:1}.tabs{position:fixed;bottom:0;left:0;right:0;background:white;display:flex;padding:12rpx 8rpx calc(12rpx + env(safe-area-inset-bottom));border-top:1rpx solid #dde5ee}.tab{flex:1;text-align:center;font-size:26rpx;padding:15rpx 0}.active{color:#2878e8;font-weight:bold}.error{background:#ffeaea;color:#b12b2b;padding:20rpx}.chart{width:100%;height:240px}.report{white-space:pre-wrap;font-size:26rpx;line-height:1.7}.symptoms{display:flex;flex-wrap:wrap;gap:20rpx}.symptoms label{font-size:26rpx}.split{display:flex;gap:20rpx}.split .card{flex:1}.list{border-bottom:1rpx solid #edf0f4;padding:20rpx 0}
