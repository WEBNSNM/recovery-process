{
	"name": "kangcheng-record-api",
	"main": "server/index.ts",
	"compatibility_date": "2026-09-01",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kangcheng-record",
			"database_id": "ec6e9a43-df66-4f5d-9441-3e98f3ff1177",
			"migrations_dir": "migrations"
		},
		{
			"binding": "kangcheng_record",
			"database_name": "kangcheng-record",
			"database_id": "ec6e9a43-df66-4f5d-9441-3e98f3ff1177",
			"remote": true
		}
	],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	}
}